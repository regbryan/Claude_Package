---
import "../styles/linear.css";
import { stats, layers, connectors, plugins, skills, subagents, workflows, installSteps, sysTools } from "../content";

const REV_DATE = new Date().toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The Stack. A Claude Code workstation, installed by hand. 165 specialist subagents, 130 workflow skills, 20 live tool connectors, three plugin marketplaces, and a parallel agent. Built around Obsidian." />
    <title>The Stack · A Claude Code workstation, installed by hand</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Recursive:slnt,wght,CASL,CRSV,MONO@-15..0,300..1000,0..1,0..1,0..1&display=swap" />
  </head>

  <body class="min-h-screen">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="relative mx-auto max-w-[1800px] px-6 md:px-10 lg:px-14">

      <!-- VARIANT SWITCHER -->
      <div class="flex items-center justify-end gap-3 pt-4 caption">
        <span style="color: var(--color-ink-subtle);">Variants:</span>
        <span style="color: var(--color-accent);">Linear</span>
        <a href="/hashicorp" class="link" style="color: var(--color-ink-subtle);">HashiCorp</a>
        <a href="/ferrari" class="link" style="color: var(--color-ink-subtle);">Ferrari</a>
      </div>

      <!-- NAV -->
      <nav class="flex items-center justify-between py-5 mt-3" style="border-bottom: 1px solid var(--color-hairline);">
        <div class="flex items-center gap-4">
          <span class="body-sm" style="font-weight: 600; letter-spacing: -0.01em;">The&nbsp;Stack</span>
          <span class="caption" style="color: var(--color-ink-subtle);">Rev {REV_DATE}</span>
        </div>
        <div class="hidden md:flex items-center gap-6 body-sm" style="color: var(--color-ink-muted);">
          <a href="#layers">Layers</a>
          <a href="#connectors">Connectors</a>
          <a href="#plugins">Plugins</a>
          <a href="#skills">Skills</a>
          <a href="#install">Install</a>
        </div>
        <a href="#install" class="btn-primary">Book install →</a>
      </nav>

      <!-- HERO -->
      <main id="main">
      <section class="pt-8 md:pt-12 pb-20 md:pb-24">
        <div class="grid grid-cols-12 gap-6">
          <div class="col-span-12 lg:col-span-10 rise">
            <div class="eyebrow mb-6" style="color: var(--color-accent);">
              The setup, fully configured
            </div>
            <h1 class="display-xl">
              A Claude Code workstation,<br/>
              installed by hand.
            </h1>
            <p class="body-lg mt-8 max-w-3xl" style="color: var(--color-ink-muted);">
              A complete, opinionated configuration of <a href="https://claude.com/claude-code">Claude Code</a>, assembled, tuned, and installed on your machine. One AI that runs your marketing, sales, design, video, engineering, operations, finance, and knowledge work. Built around <a href="https://obsidian.md">Obsidian</a>. Paired with <strong style="color: var(--color-ink); font-variant-numeric: tabular-nums;">165 specialist subagents, 130 workflow skills, 20 live tool connectors, three plugin marketplaces</strong>, and a parallel agent running another 100 skills in the background.
            </p>
            <div class="mt-10 flex flex-wrap items-center gap-3">
              <a href="#install" class="btn-primary">Begin installation</a>
              <a href="#layers" class="btn-secondary">View the seven layers</a>
            </div>
          </div>
        </div>
      </section>

      <!-- OBSIDIAN -->
      <section class="py-20 md:py-24">
        <div class="card" style="padding: 48px;">
          <div class="grid grid-cols-12 gap-6">
            <div class="col-span-12 md:col-span-5">
              <span class="eyebrow" style="color: var(--color-accent);">Featured · The brain of the setup</span>
              <h2 class="display-lg mt-4">Obsidian is the brain of the operation.</h2>
              <a href="https://obsidian.md" class="link body-sm mt-6 inline-block">obsidian.md →</a>
            </div>
            <div class="col-span-12 md:col-span-7 body-base prose space-y-4" style="color: var(--color-ink-muted);">
              <p><strong style="color: var(--color-ink);"><a href="https://obsidian.md">Obsidian</a> is your second brain and the system of record for the entire setup.</strong> Every Claude session ends with an automatic log entry in your vault. Every brief, recap, research note, meeting summary, and project plan lands there.</p>
              <p>When Claude needs to remember last week, it searches your vault. When you want to know what got done, it's already written down. <a href="#hermes">Hermes</a>, the parallel agent, also reads and writes to Obsidian.</p>
              <p style="color: var(--color-ink);">Your notes are plain Markdown files on your machine. No one else's cloud. The setup turns it into the persistent memory layer that ties everything else together.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- LAYERS -->
      <section id="layers" class="py-20 md:py-24">
        <div class="grid grid-cols-12 gap-6 mb-14">
          <div class="col-span-12 md:col-span-5">
            <span class="eyebrow" style="color: var(--color-ink-subtle);">§ 01 · System architecture</span>
            <h2 class="display-lg mt-4">The seven layers.</h2>
          </div>
          <div class="col-span-12 md:col-span-6 md:col-start-7 body-lg" style="color: var(--color-ink-muted);">
            Each layer is independent. Each replaceable. Together they make a stack that's hard to walk away from once you've used it for a week.
          </div>
        </div>

        <div class="grid grid-cols-12 gap-6">
          {layers.map((l) => (
            <div class="col-span-12 md:col-span-10 md:col-start-2 grid grid-cols-12 gap-6 py-7" style="border-top: 1px solid var(--color-hairline);">
              <div class="col-span-12 md:col-span-2 hang-num" style="color: var(--color-accent);">§ {l.id}</div>
              <div class="col-span-12 md:col-span-4 card-title">{l.t}</div>
              <p class="col-span-12 md:col-span-6 body-base" style="color: var(--color-ink-muted);">{l.d}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- CONNECTORS -->
      <section id="connectors" class="py-20 md:py-24">
        <div class="grid grid-cols-12 gap-6 mb-14">
          <div class="col-span-12 md:col-span-5">
            <h2 class="display-lg">Live two-way OAuth links.</h2>
          </div>
          <div class="col-span-12 md:col-span-6 md:col-start-7 body-lg" style="color: var(--color-ink-muted);">
            Sign in once per connector. After that, Claude reads, writes, and acts inside each tool the same way you would. All credentials live on your machine.
          </div>
        </div>

        <div style="border-top: 1px solid var(--color-hairline);">
          {connectors.map((g) => (
            <div class="run-row">
              <div class="card-title" style="font-size: 17px;">{g.group}</div>
              <div class="body-base" style="color: var(--color-ink-muted);">
                {g.items.map((it, i) => (
                  <>
                    {it.url ? <a href={it.url} class="link">{it.n}</a> : <span style="color: var(--color-ink);">{it.n}</span>}
                    {i < g.items.length - 1 && <span style="color: var(--color-ink-tertiary);">  ·  </span>}
                  </>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- PLUGINS -->
      <section id="plugins" class="py-20 md:py-24">
        <div class="grid grid-cols-12 gap-6 mb-12">
          <div class="col-span-12 md:col-span-5">
            <h2 class="display-lg">Three marketplaces.<br/>Sixteen plugins.</h2>
          </div>
          <div class="col-span-12 md:col-span-6 md:col-start-7 body-lg" style="color: var(--color-ink-muted);">
            Bundles of related capabilities. The setup pulls from three marketplaces, each curated for a different purpose.
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          {plugins.map((p) => (
            <article class="card">
              <div class="eyebrow mb-4" style="color: var(--color-accent);">{p.n}</div>
              <h3 class="card-title">{p.t}</h3>
              <p class="body-sm mt-3" style="color: var(--color-ink-muted); font-style: italic;">{p.note}</p>
              <div class="hairline my-5"></div>
              <ul class="space-y-1.5 body-sm" style="color: var(--color-ink-muted);">
                {p.items.map((it) => <li>{it}</li>)}
              </ul>
              <a href={p.url} class="link caption mt-5 inline-block">{p.repo} ↗</a>
            </article>
          ))}
        </div>
      </section>

      <!-- SKILLS -->
      <section id="skills" class="py-20 md:py-24">
        <div class="grid grid-cols-12 gap-6 mb-14">
          <div class="col-span-12 md:col-span-5">
            <span class="eyebrow" style="color: var(--color-ink-subtle);">§ 04 · Skills</span>
            <h2 class="display-lg mt-4">130 workflows.<br/>Invoked automatically.</h2>
          </div>
          <div class="col-span-12 md:col-span-6 md:col-start-7 body-lg" style="color: var(--color-ink-muted);">
            You don't pick them. They activate based on the request. The full taxonomy below.
          </div>
        </div>

        <div style="border-top: 1px solid var(--color-hairline);">
          {skills.map((g) => (
            <div class="run-row">
              <div class="card-title" style="font-size: 17px;">{g.t}</div>
              <div class="mono" style="color: var(--color-ink-muted); font-size: 13.5px; line-height: 1.75;">
                {g.items.join(", ")}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SUBAGENTS -->
      <section class="py-20 md:py-24">
        <div class="grid grid-cols-12 gap-6">
          <div class="col-span-12 md:col-span-5">
            <h2 class="display-lg">A specialist team of <span style="color: var(--color-accent);">165</span>, across thirteen domains.</h2>
          </div>
          <div class="col-span-12 md:col-span-6 md:col-start-7 body-lg" style="color: var(--color-ink-muted);">
            <p>Named expert personas Claude delegates to when a task needs deep specialization. Say <em>"audit my landing page,"</em> and Claude pulls in the accessibility auditor, the paid-media creative strategist, the design critique agent, and the reality checker, automatically. The roster:</p>
            <p class="mt-6 body-base" style="color: var(--color-ink); line-height: 1.8;">
              {subagents.map((g, i) => (
                <>
                  <strong>{g.t}</strong> <span style="color: var(--color-ink-muted);">({g.n})</span>{i < subagents.length - 1 && <span style="color: var(--color-ink-tertiary);">  ·  </span>}
                </>
              ))}
            </p>
          </div>
        </div>
      </section>

      <!-- HERMES -->
      <section id="hermes" class="py-20 md:py-24">
        <div class="card" style="padding: 48px;">
          <div class="grid grid-cols-12 gap-6">
            <div class="col-span-12 md:col-span-5">
              <span class="eyebrow" style="color: var(--color-accent);">§ 06 · The parallel agent</span>
              <h2 class="display-lg mt-4">Hermes never sleeps.</h2>
            </div>
            <div class="col-span-12 md:col-span-7 body-base prose space-y-4" style="color: var(--color-ink-muted);">
              <p>Hermes is a parallel Python-based agent that runs autonomous and scheduled work while Claude Code handles your interactive sessions. They share your filesystem but operate independently.</p>
              <p style="color: var(--color-ink);">100+ Hermes skills across Apple ecosystem, autonomous orchestration, creative tooling, DevOps, GitHub, MCP scaffolding, MLOps, note-taking, productivity, research, and software development.</p>
              <p style="font-style: italic;">Example: <em>"Every weekday at 7am, run my morning brief: yesterday's calendar, today's calendar, overnight inbox, top 3 priorities. Drop it in Obsidian and Slack it to me."</em> Hermes handles the cron. You just receive the brief.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- WORKFLOWS -->
      <section class="py-20 md:py-24">
        <div class="grid grid-cols-12 gap-6 mb-14">
          <div class="col-span-12 md:col-span-5">
            <h2 class="display-lg">What you'll actually say to it.</h2>
          </div>
          <div class="col-span-12 md:col-span-6 md:col-start-7 body-lg" style="color: var(--color-ink-muted);">
            Plain English. A sample of real day-to-day requests below, pasted verbatim from client logs.
          </div>
        </div>

        <div class="grid grid-cols-12 gap-6">
          {workflows.map((w, i) => (
            <figure class="col-span-12 md:col-span-10 md:col-start-2 grid grid-cols-12 gap-6 py-7" style="border-top: 1px solid var(--color-hairline);">
              <div class="col-span-12 md:col-span-2 hang-num" style="color: var(--color-accent);">№ {String(i + 1).padStart(2, "0")} <span style="color: var(--color-ink-subtle);">/ {w.cat}</span></div>
              <blockquote class="col-span-12 md:col-span-10 body-lg" style="font-size: 20px; line-height: 1.5; color: var(--color-ink);">"{w.q}"</blockquote>
            </figure>
          ))}
        </div>
      </section>

      <!-- INSTALL -->
      <section id="install" class="py-20 md:py-24">
        <div class="grid grid-cols-12 gap-6 mb-12">
          <div class="col-span-12 md:col-span-7">
            <span class="eyebrow" style="color: var(--color-ink-subtle);">§ 08 · Installation</span>
            <h2 class="display-lg mt-4">Procedure.</h2>
          </div>
          <div class="col-span-12 md:col-span-5 body-lg" style="color: var(--color-ink-muted);">
            Ten steps. 60–90 minutes. Mostly automated. The slow part is signing in.
          </div>
        </div>

        <ol style="border-top: 1px solid var(--color-hairline);">
          {installSteps.map((s) => (
            <li class="grid grid-cols-12 gap-4 py-5 items-baseline" style="border-bottom: 1px solid var(--color-hairline);">
              <div class="col-span-2 md:col-span-1 hang-num" style="color: var(--color-accent);">{s.id}</div>
              <div class="col-span-10 md:col-span-4 card-title" style="font-size: 18px;">{s.t}</div>
              <div class="col-span-4 md:col-span-2 caption" style="color: var(--color-ink-subtle); font-variant-numeric: tabular-nums;">{s.time}</div>
              <div class="col-span-12 md:col-span-5 body-base" style="color: var(--color-ink-muted);">
                {s.d}
                {s.link && (<>{" "}<a href={s.link.url} class="link">{s.link.t} ↗</a></>)}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- SYSTEM TOOLING -->
      <section class="py-12 md:py-16">
        <div class="grid grid-cols-12 gap-6 mb-12">
          <div class="col-span-12 md:col-span-7">
            <h2 class="display-md mt-2">System tooling.</h2>
          </div>
          <div class="col-span-12 md:col-span-5 body-lg" style="color: var(--color-ink-muted);">
            All local, all free, no SaaS lock-in.
          </div>
        </div>

        <p class="body-base max-w-4xl" style="color: var(--color-ink-muted); line-height: 1.85;">
          {sysTools.map((tool, i) => (
            <>
              <a href={tool.url} class="link">{tool.n}</a>
              <span style="color: var(--color-ink-subtle);"> ({tool.d})</span>
              {i < sysTools.length - 1 && <span style="color: var(--color-ink-subtle);">  ·  </span>}
            </>
          ))}
        </p>
      </section>

      <!-- CTA -->
      <section class="py-20 md:py-24">
        <div class="cta-banner">
          <div class="grid grid-cols-12 gap-6 items-end">
            <div class="col-span-12 md:col-span-8">
              <span class="eyebrow" style="color: var(--color-accent);">§ 10 · Begin</span>
              <h2 class="display-lg mt-4">Pick a date. I'll handle the rest.</h2>
              <p class="body-lg mt-5 max-w-2xl" style="color: var(--color-ink-muted);">
                Reach out and we'll book a 90-minute install window. I prep your config in advance. Your time is spent confirming logins and seeing the stack work.
              </p>
            </div>
            <div class="col-span-12 md:col-span-4 flex flex-col gap-3 md:items-end">
              <a href="#" class="btn-primary">Book install →</a>
              <a href="#" class="btn-secondary">Talk first</a>
            </div>
          </div>
        </div>
      </section>

      </main>

      <!-- FOOTER -->
      <footer class="py-12 md:py-16" style="border-top: 1px solid var(--color-hairline);">
        <div class="grid grid-cols-12 gap-6">
          <div class="col-span-6 md:col-span-3">
            <div class="caption mb-3" style="color: var(--color-ink-muted);">THE STACK</div>
            <p class="body-sm" style="color: var(--color-ink-muted);">A Claude Code workstation, installed by hand. Maintained quarterly.</p>
          </div>
          <div class="col-span-6 md:col-span-3">
            <div class="caption mb-3" style="color: var(--color-ink-muted);">Operator</div>
            <p class="body-sm">Reggie</p>
          </div>
          <div class="col-span-6 md:col-span-3">
            <div class="caption mb-3" style="color: var(--color-ink-muted);">Set in</div>
            <p class="body-sm" style="color: var(--color-ink-muted);"><a href="https://www.recursive.design" class="link">Recursive</a></p>
            <p class="caption mt-1" style="color: var(--color-ink-subtle);">Variable axis, software-craft</p>
          </div>
          <div class="col-span-6 md:col-span-3">
            <div class="caption mb-3" style="color: var(--color-ink-muted);">Design</div>
            <p class="caption" style="color: var(--color-ink-subtle);">Built on the <a href="https://github.com/voltagent/awesome-design-md" class="link">Linear.app DESIGN.md</a>. Two alternate variants available at <a href="/hashicorp" class="link">/hashicorp</a> and <a href="/ferrari" class="link">/ferrari</a>.</p>
          </div>
        </div>
        <div class="hairline mt-10"></div>
        <div class="flex flex-wrap items-baseline justify-between mt-4 gap-3">
          <div class="caption" style="color: var(--color-ink-subtle);">Rev {REV_DATE} · Document STK-001</div>
          <div class="caption" style="color: var(--color-ink-subtle);">All credentials local · OAuth · Revoke anytime</div>
        </div>
      </footer>

    </div>
  </body>
</html>
