                <div class="col-span-10 md:col-span-3 card-title">{s.t}</div>
                <div class="col-span-3 md:col-span-2 caption text-ink-muted">{s.time}</div>
                <div class="col-span-9 md:col-span-6 body-sm text-ink-muted">
                  {s.d}
                  {s.link && (<>
                    {" "}<a href={s.link.url} class="link">{s.link.t} ↗</a>
                  </>)}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>

